<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-arrow-left-right"></i> Transaction Logs</h2>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-secondary">
                    <tr>
                        <th>Transaction ID</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Performed By</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (transactions.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No transactions recorded yet.</td>
                        </tr>
                    <% } %>
                    <% transactions.forEach(txn => { %>
                        <tr>
                            <td><span class="badge bg-secondary"><%= txn.transactionId || 'TXN-TEMP' %></span></td>
                            <td><%= txn.createdAt ? new Date(txn.createdAt).toLocaleString() : 'N/A' %></td>
                            <td>
                                <span class="badge bg-<%= txn.type === 'sale' ? 'success' : txn.type === 'purchase' ? 'primary' : 'warning text-dark' %>">
                                    <i class="bi bi-<%= txn.type === 'sale' ? 'arrow-up-right' : txn.type === 'purchase' ? 'arrow-down-left' : 'arrow-left-right' %>"></i>
                                    <%= (txn.type || 'N/A').toUpperCase() %>
                                </span>
                            </td>
                            <td class="fw-bold">Rs.<%= (txn.totalAmount || txn.amount || 0).toLocaleString() %></td>
                            <td>
                                <span class="badge bg-<%= txn.status === 'completed' ? 'success' : txn.status === 'pending' ? 'warning text-dark' : 'danger' %>">
                                    <%= (txn.status || 'N/A').toUpperCase() %>
                                </span>
                            </td>
                            <td><%= txn.performedBy ? txn.performedBy.name : 'System' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
