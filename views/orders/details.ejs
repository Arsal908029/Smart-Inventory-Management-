<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-cart"></i> Order Details: <%= order.orderNumber %></h2>
            <div>
                <% if (order.status === 'pending') { %>
                    <form action="/orders/<%= order._id %>/status" method="POST" class="d-inline" onsubmit="return confirm('Complete this order? This will generate an invoice and cannot be undone.');">
                        <input type="hidden" name="status" value="completed">
                        <button type="submit" class="btn btn-success me-2">
                            <i class="bi bi-check-circle"></i> Mark as Completed
                        </button>
                    </form>
                    <form action="/orders/<%= order._id %>/status" method="POST" class="d-inline" onsubmit="return confirm('Cancel this order? This will restock the items.');">
                        <input type="hidden" name="status" value="cancelled">
                        <button type="submit" class="btn btn-danger me-2">
                            <i class="bi bi-x-circle"></i> Cancel Order
                        </button>
                    </form>
                <% } %>
                <% if (typeof invoice !== 'undefined' && invoice) { %>
                    <a href="/invoices/<%= invoice._id %>" class="btn btn-primary me-2">
                        <i class="bi bi-file-earmark-text"></i> View Invoice
                    </a>
                <% } %>
                <a href="/orders" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Orders
                </a>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Customer Details -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-body-tertiary">
                        <h6 class="mb-0">Customer Information</h6>
                    </div>
                    <div class="card-body">
                        <p class="mb-1"><strong>Name:</strong> <%= order.customer.name %></p>
                        <p class="mb-1"><strong>Email:</strong> <%= order.customer.email || 'N/A' %></p>
                        <p class="mb-1"><strong>Phone:</strong> <%= order.customer.phone || 'N/A' %></p>
                        <p class="mb-0"><strong>Address:</strong> <%= typeof order.customer.address === 'string' ? order.customer.address : 'N/A' %></p>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-body-tertiary">
                        <h6 class="mb-0">Order Summary</h6>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-sm-5 text-muted">Date:</div>
                            <div class="col-sm-7"><%= new Date(order.createdAt).toLocaleString() %></div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-5 text-muted">Status:</div>
                            <div class="col-sm-7">
                                <span class="badge bg-<%= order.status === 'completed' ? 'success' : order.status === 'pending' ? 'primary' : 'secondary' %>">
                                    <%= order.status.toUpperCase() %>
                                </span>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-5 text-muted">Payment Method:</div>
                            <div class="col-sm-7">
                                <span class="badge bg-body-tertiary text-body border text-uppercase">
                                    <%= (order.paymentMethod || 'N/A').replace('_', ' ') %>
                                </span>
                            </div>
                        </div>
                        <div class="row mb-0">
                            <div class="col-sm-5 text-muted">Payment Status:</div>
                            <div class="col-sm-7">
                                <span class="badge bg-<%= order.paymentStatus === 'paid' ? 'success' : order.paymentStatus === 'pending' ? 'warning text-dark' : 'danger' %>">
                                    <%= (order.paymentStatus || 'pending').toUpperCase() %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="card shadow-sm">
            <div class="card-header bg-body-tertiary">
                <h6 class="mb-0">Order Items</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% order.items.forEach(item => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <% if (item.product && item.product.images && item.product.images.length > 0) { %>
                                                <img src="<%= item.product.images[0].url %>" class="rounded shadow-sm" width="40" height="40" style="object-fit: cover;">
                                            <% } else { %>
                                                <div class="bg-body-tertiary rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                    <i class="bi bi-box text-muted"></i>
                                                </div>
                                            <% } %>
                                            <div>
                                                <div class="fw-bold"><%= item.name %></div>
                                                <small class="text-muted">SKU: <%= item.sku %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-secondary"><%= item.sku %></span></td>
                                    <td>Rs.<%= (item.price || 0).toLocaleString() %></td>
                                    <td><%= item.quantity %></td>
                                    <td class="text-end fw-bold">Rs.<%= ((item.price || 0) * (item.quantity || 0)).toLocaleString() %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Total:</td>
                                <td class="text-end text-success fw-bold fs-5">Rs.<%= (order.total || 0).toLocaleString() %></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
