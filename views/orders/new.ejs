<div class="flex-between">
  <h1 class="title">Create New Order</h1>
  <a href="/orders" class="btn btn-secondary">Back to Orders</a>
</div>

<div class="card" style="max-width: 800px;">
  <form action="/orders" method="POST">
    
    <div class="form-group">
      <h3 style="font-size: 1.125rem; margin-bottom: 1rem;">Add Items</h3>
      <div style="background: rgba(255,255,255,0.05); padding: 1rem; border-radius: var(--radius); border: 1px solid var(--border); margin-bottom: 1rem;">
        <p style="font-size: 0.875rem; color: var(--muted); margin-bottom: 0.5rem;">For now, you must manually provide the Product ID and Quantity.</p>
        
        <div class="grid-2">
          <div>
            <label for="productId" class="form-label">Product ID</label>
            <input type="text" id="productId" name="items[0][product]" class="form-control" required placeholder="Paste a valid Product ID">
          </div>
          <div>
            <label for="quantity" class="form-label">Quantity</label>
            <input type="number" id="quantity" name="items[0][quantity]" class="form-control" required min="1" value="1">
          </div>
        </div>
      </div>
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem;">Create Order</button>
  </form>
</div>
