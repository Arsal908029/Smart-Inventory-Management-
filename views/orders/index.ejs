<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-cart"></i> Orders</h2>
    <a href="/orders/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Order
    </a>
</div>

<!-- Search and Filter -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form action="/orders" method="GET" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-muted small">Search Orders</label>
                <div class="input-group">
                    <span class="input-group-text bg-body"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" name="search" placeholder="Order #, Customer Name, or Email..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small">Filter by Status</label>
                <select class="form-select" name="status">
                    <option value="all" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'all') ? 'selected' : '' %>>All Statuses</option>
                    <option value="pending" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'pending') ? 'selected' : '' %>>Pending</option>
                    <option value="completed" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'completed') ? 'selected' : '' %>>Completed</option>
                    <option value="cancelled" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'cancelled') ? 'selected' : '' %>>Cancelled</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary me-2 px-4">Filter</button>
                <a href="/orders" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-secondary">
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Items</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (orders.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No orders found. Click 'Create New Order' to add one.</td>
                        </tr>
                    <% } %>
                    <% orders.forEach(order => { %>
                        <tr>
                            <td class="fw-bold"><%= order.orderNumber || 'Legacy Order' %></td>
                            <td><%= order.createdAt ? new Date(order.createdAt).toLocaleDateString() : 'N/A' %></td>
                            <td>
                                <div><%= (order.customer && order.customer.name) ? order.customer.name : 'Guest/Legacy' %></div>
                                <small class="text-muted"><%= (order.customer && order.customer.email) ? order.customer.email : '' %></small>
                            </td>
                            <td class="fw-bold">Rs.<%= (order.total || 0).toLocaleString() %></td>
                            <td><span class="badge bg-body-tertiary text-body"><%= order.items ? order.items.length : 0 %></span></td>
                            <td>
                                <span class="badge bg-<%= order.paymentStatus === 'paid' ? 'success' : order.paymentStatus === 'pending' ? 'warning text-dark' : 'danger' %>">
                                    <%= order.paymentStatus.toUpperCase() %>
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-<%= order.status === 'completed' ? 'success' : order.status === 'pending' ? 'primary' : 'secondary' %>">
                                    <%= order.status.toUpperCase() %>
                                </span>
                            </td>
                            <td class="text-end">
                                <a href="/orders/<%= order._id %>" class="btn btn-sm btn-outline-info" title="View Details">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
