<!DOCTYPE html>
<html lang="en" data-bs-theme="<%= typeof user !== 'undefined' && user && user.theme === 'dark' ? 'dark' : 'light' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Smart Inventory System' %> | Smart Inventory System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css?v=2">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <% if (user) { %>
        <%- include('sidebar') %>
    <% } %>
    
    <div class="<%= user ? 'main-content' : 'auth-page-wrapper' %>">
        <% if (user) { %>
            <%- include('header') %>
        <% } %>
        
        <main class="<%= user ? 'container-fluid mt-4' : '' %>">
            <%- body %>
        </main>
        
        <% if (user) { %>
            <%- include('footer') %>
        <% } %>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/dashboard.js"></script>
    <script src="/js/validation.js"></script>
</body>
</html>
