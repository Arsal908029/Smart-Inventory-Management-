<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-box"></i> Product Details</h2>
            <div>
                <a href="/products/<%= product._id %>/edit" class="btn btn-primary me-2 shadow-sm">
                    <i class="bi bi-pencil"></i> Edit Product
                </a>
                <form action="/products/<%= product._id %>/delete" method="POST" class="d-inline me-2" onsubmit="return confirm('Archive this product?')">
                    <button type="submit" class="btn btn-danger shadow-sm">
                        <i class="bi bi-trash"></i> Delete Product
                    </button>
                </form>
                <a href="/products" class="btn btn-outline-secondary shadow-sm">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>

        <% if (needsReorder) { %>
            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <strong>Low Stock Alert!</strong> This product has fallen below its reorder level of <%= product.reorderLevel %>. 
                    Consider reordering <%= product.reorderQuantity %> units soon.
                </div>
            </div>
        <% } %>

        <div class="row g-4">
            <!-- Product Images -->
            <div class="col-md-5">
                <div class="card shadow-sm mb-4">
                    <div class="card-body p-2">
                        <% if (product.images && product.images.length > 0) { %>
                            <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner rounded">
                                    <% product.images.forEach((img, index) => { %>
                                        <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                            <img src="<%= img.url %>" class="d-block w-100" alt="<%= img.alt || product.name %>" style="height: 300px; object-fit: cover;">
                                        </div>
                                    <% }) %>
                                </div>
                                <% if (product.images.length > 1) { %>
                                    <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon"></span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                                        <span class="carousel-control-next-icon"></span>
                                    </button>
                                <% } %>
                            </div>
                        <% } else { %>
                            <div class="bg-body-tertiary d-flex flex-column align-items-center justify-content-center rounded" style="height: 300px;">
                                <i class="bi bi-image text-muted display-1"></i>
                                <p class="text-muted mt-2">No images available</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Product Information</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Name</dt>
                            <dd class="col-sm-7 fw-bold text-primary"><%= product.name %></dd>

                            <dt class="col-sm-5">SKU</dt>
                            <dd class="col-sm-7"><span class="badge bg-secondary"><%= product.sku %></span></dd>

                            <dt class="col-sm-5">Category</dt>
                            <dd class="col-sm-7"><%= product.category ? product.category.name : 'Uncategorized' %></dd>

                            <dt class="col-sm-5">Selling Price</dt>
                            <dd class="col-sm-7 text-success fw-bold">Rs.<%= (product.price || 0).toLocaleString() %></dd>

                            <dt class="col-sm-5">Unit Cost</dt>
                            <dd class="col-sm-7 text-muted">Rs.<%= (product.cost || 0).toLocaleString() %></dd>

                            <dt class="col-sm-5">Current Stock</dt>
                            <dd class="col-sm-7">
                                <% if (product.quantity <= product.reorderLevel) { %>
                                    <span class="badge bg-danger fs-6"><%= product.quantity %></span>
                                <% } else { %>
                                    <span class="badge bg-success fs-6"><%= product.quantity %></span>
                                <% } %>
                            </dd>

                            <dt class="col-sm-5">Description</dt>
                            <dd class="col-sm-7 text-muted small"><%= product.description || 'No description provided.' %></dd>
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Stock History Card -->
            <div class="col-md-7">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Recent Stock History</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Qty Change</th>
                                        <th>New Total</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (stockHistory.length === 0) { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">No stock history available.</td>
                                        </tr>
                                    <% } %>
                                    <% stockHistory.forEach(history => { %>
                                        <tr>
                                            <td><small><%= history.date ? new Date(history.date).toLocaleDateString() : 'N/A' %></small></td>
                                            <td>
                                                <% if (history.type === 'sale') { %>
                                                    <span class="badge bg-danger">Sale</span>
                                                <% } else if (history.type === 'purchase' || history.type === 'opening') { %>
                                                    <span class="badge bg-success">Purchase</span>
                                                <% } else { %>
                                                    <span class="badge bg-warning text-dark">Adjustment</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (history.type === 'sale') { %>
                                                    <span class="text-danger">▼ <%= history.quantity %></span>
                                                <% } else { %>
                                                    <span class="text-success">▲ <%= history.quantity %></span>
                                                <% } %>
                                            </td>
                                            <td class="fw-bold"><%= history.newStock %></td>
                                            <td><small class="text-muted"><%= history.notes || '-' %></small></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Supplier Information Card -->
                <div class="card shadow-sm mt-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="bi bi-truck"></i> Supplier Information</h5>
                    </div>
                    <div class="card-body">
                        <% if (product.supplierDetails && product.supplierDetails.length > 0) { %>
                            <% const supplier = product.supplierDetails[0]; %>
                            <div class="row">
                                <div class="col-md-6">
                                    <h5 class="text-primary fw-bold mb-1"><%= supplier.name %></h5>
                                    <p class="text-muted small mb-3">Rating: 
                                        <% for(let i=1; i<=5; i++) { %>
                                            <i class="bi bi-star-fill <%= i <= supplier.rating ? 'text-warning' : 'text-secondary opacity-25' %>"></i>
                                        <% } %>
                                    </p>
                                    <p class="mb-1"><i class="bi bi-person text-muted me-2"></i> <%= supplier.contact %></p>
                                    <p class="mb-1"><i class="bi bi-envelope text-muted me-2"></i> <a href="mailto:<%= supplier.email %>"><%= supplier.email %></a></p>
                                </div>
                                <div class="col-md-6 border-start">
                                    <p class="mb-1"><i class="bi bi-telephone text-muted me-2"></i> <%= supplier.phone %></p>
                                    <p class="mb-1"><i class="bi bi-clock-history text-muted me-2"></i> Lead Time: <strong><%= supplier.leadTimeDays %> days</strong></p>
                                    <p class="mb-0 mt-2 text-muted small"><i class="bi bi-geo-alt me-1"></i> <%= supplier.address || 'No address provided' %></p>
                                </div>
                            </div>
                        <% } else if (product.supplier && product.supplier.name) { %>
                            <div class="alert alert-info mb-0">
                                <i class="bi bi-info-circle me-2"></i> Using legacy supplier text info.
                                <br>
                                <strong><%= product.supplier.name %></strong> - <%= product.supplier.phone %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-3 text-muted">
                                <i class="bi bi-truck display-6 mb-2 d-block opacity-25"></i>
                                No primary supplier assigned to this product.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
