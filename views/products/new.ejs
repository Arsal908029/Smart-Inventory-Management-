<div class="flex-between">
  <h1>Add New Product</h1>
  <a href="/products" class="btn btn-secondary">Back to Products</a>
</div>

<div class="card" style="max-width: 800px;">
  <form action="/products" method="POST">
    <div class="grid-2">
      <div class="form-group">
        <label for="name" class="form-label">Product Name</label>
        <input type="text" id="name" name="name" class="form-control" required placeholder="e.g. Wireless Mouse">
      </div>
      
      <div class="form-group">
        <label for="sku" class="form-label">SKU</label>
        <input type="text" id="sku" name="sku" class="form-control" placeholder="Unique identifier">
      </div>
    </div>

    <div class="grid-2">
      <div class="form-group">
        <label for="price" class="form-label">Price (Rs.)</label>
        <input type="number" step="0.01" id="price" name="price" class="form-control" required min="0">
      </div>
      
      <div class="form-group">
        <label for="quantity" class="form-label">Initial Quantity</label>
        <input type="number" id="quantity" name="quantity" class="form-control" required min="0" value="0">
      </div>
    </div>

    <div class="form-group">
      <label for="category" class="form-label">Category Object ID</label>
      <input type="text" id="category" name="category" class="form-control" required placeholder="Paste a valid Category ID here">
      <small style="color: var(--muted); display: block; margin-top: 0.5rem;">
        Note: You currently need the Category ID. (To improve this, pass `categories` to the /new route in productController).
      </small>
    </div>

    <div class="form-group">
      <label for="description" class="form-label">Description</label>
      <textarea id="description" name="description" class="form-control" rows="4"></textarea>
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem;">Create Product</button>
  </form>
</div>
