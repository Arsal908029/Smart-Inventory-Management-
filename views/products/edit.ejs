<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="d-flex justify-content-between align-items-center mb-4 animate-up">
            <div>
                <h2 class="fw-bold mb-1">Edit Product</h2>
                <p class="text-muted small">Update the information for <strong><%= product.name %></strong>.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/products/<%= product._id %>" class="btn btn-light shadow-sm">
                    <i class="bi bi-eye"></i> View Details
                </a>
                <a href="/products" class="btn btn-light shadow-sm">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <div class="card shadow-sm animate-up">
            <div class="card-body p-0">
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger m-4 alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-octagon me-2"></i> <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <form action="/products/<%= product._id %>?_method=PUT" method="POST" id="productForm">
                    <ul class="nav nav-tabs nav-fill bg-body-tertiary border-bottom" id="productTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active py-3 fw-bold" data-bs-toggle="tab" data-bs-target="#general" type="button">General</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-3 fw-bold" data-bs-toggle="tab" data-bs-target="#pricing" type="button">Pricing & Stock</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-3 fw-bold" data-bs-toggle="tab" data-bs-target="#media" type="button">Media</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-3 fw-bold" data-bs-toggle="tab" data-bs-target="#advanced" type="button">Advanced</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-3 fw-bold" data-bs-toggle="tab" data-bs-target="#seo" type="button">SEO</button>
                        </li>
                    </ul>

                    <div class="tab-content p-4">
                        <!-- General -->
                        <div class="tab-pane fade show active" id="general">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold small text-uppercase">Product Name</label>
                                    <input type="text" class="form-control form-control-lg" name="name" required value="<%= product.name %>">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-uppercase">SKU</label>
                                    <input type="text" class="form-control form-control-lg text-uppercase" name="sku" required value="<%= product.sku %>">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-uppercase">Category</label>
                                    <select class="form-select" name="category" required>
                                        <% categories.forEach(cat => { %>
                                            <option value="<%= cat._id %>" <%= product.category._id.toString() == cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-uppercase">Tags</label>
                                    <input type="text" class="form-control" name="tags" value="<%= product.tags ? product.tags.join(', ') : '' %>">
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold small text-uppercase">Description</label>
                                    <textarea class="form-control" name="description" rows="5"><%= product.description %></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Pricing & Stock -->
                        <div class="tab-pane fade" id="pricing">
                            <div class="row g-4">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-uppercase">Selling Price</label>
                                    <input type="number" step="0.01" class="form-control" name="price" value="<%= product.price %>">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-uppercase">Cost Price</label>
                                    <input type="number" step="0.01" class="form-control" name="cost" value="<%= product.cost %>">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-uppercase">Current Quantity</label>
                                    <input type="number" class="form-control" name="quantity" value="<%= product.quantity %>">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-uppercase">Reorder Level</label>
                                    <input type="number" class="form-control" name="reorderLevel" value="<%= product.reorderLevel %>">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-uppercase">Adjustment Notes</label>
                                    <input type="text" class="form-control" name="stockNotes" placeholder="Reason for change (e.g. damaged stock)">
                                </div>
                            </div>
                        </div>

                        <!-- Media -->
                        <div class="tab-pane fade" id="media">
                            <div class="row g-3">
                                <% product.images.forEach(img => { %>
                                    <div class="col-md-3">
                                        <div class="card shadow-sm h-100">
                                            <img src="<%= img.url %>" class="card-img-top" style="height: 150px; object-fit: cover;">
                                            <div class="card-footer p-2 text-center">
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="primaryImage" value="<%= img.url %>" <%= img.isPrimary ? 'checked' : '' %>>
                                                    <label class="form-check-label small">Primary</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                            <div class="mt-4">
                                <label class="form-label fw-bold small text-uppercase">Add Image URLs</label>
                                <textarea class="form-control" name="imageUrls" placeholder="New URLs..."></textarea>
                            </div>
                        </div>

                        <!-- Advanced -->
                        <div class="tab-pane fade" id="advanced">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label small">Weight (kg)</label>
                                    <input type="number" step="0.01" class="form-control" name="weight" value="<%= product.weight?.value %>">
                                </div>
                                <div class="col-md-9">
                                    <label class="form-label small">Primary Supplier</label>
                                    <select class="form-select" name="supplier">
                                        <option value="">-- No Supplier Assigned --</option>
                                        <% suppliers.forEach(sup => { %>
                                            <option value="<%= sup._id %>" <%= product.suppliers && product.suppliers.includes(sup._id) ? 'selected' : '' %>><%= sup.name %> (Lead Time: <%= sup.leadTimeDays %> days)</option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- SEO -->
                        <div class="tab-pane fade" id="seo">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-bold small text-uppercase">Meta Title</label>
                                    <input type="text" class="form-control" name="metaTitle" value="<%= product.seo?.title %>">
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold small text-uppercase">Meta Description</label>
                                    <textarea class="form-control" name="metaDescription" rows="3"><%= product.seo?.description %></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-body border-top p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <form action="/products/<%= product._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Archive this product?')">
                                    <button type="submit" class="btn btn-outline-danger shadow-sm">
                                        <i class="bi bi-trash"></i> Delete Product
                                    </button>
                                </form>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/products" class="btn btn-light">Cancel</a>
                                <button type="submit" class="btn btn-primary px-5 shadow-sm">Update Product</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
