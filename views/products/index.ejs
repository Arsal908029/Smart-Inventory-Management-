<div class="inventory-wrapper">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 animate-up">
        <div>
            <h1 class="fw-bold mb-1">Product Inventory</h1>
            <p class="text-muted mb-0">Manage and track your product stock levels across all categories.</p>
        </div>
        <div class="d-flex gap-2">
            <div class="btn-group shadow-sm">
                <a href="/products?<%= new URLSearchParams({...query, view: 'grid'}).toString() %>" class="btn btn-light <%= view === 'grid' ? 'active' : '' %>" title="Grid View">
                    <i class="bi bi-grid-3x3-gap"></i>
                </a>
                <a href="/products?<%= new URLSearchParams({...query, view: 'list'}).toString() %>" class="btn btn-light <%= view === 'list' ? 'active' : '' %>" title="List View">
                    <i class="bi bi-list-ul"></i>
                </a>
            </div>
            <a href="/products/create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg"></i> Add New Product
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Filters -->
        <div class="col-lg-3">
            <div class="card shadow-sm animate-up">
                <div class="card-header bg-body">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-filter"></i> Filters</h6>
                </div>
                <div class="card-body">
                    <form action="/products" method="GET" id="filterForm">
                        <input type="hidden" name="view" value="<%= view %>">
                        
                        <!-- Search -->
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase">Search</label>
                            <div class="input-group">
                                <span class="input-group-text bg-body border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" name="search" class="form-control border-start-0" placeholder="Name, SKU, Barcode..." value="<%= query.search %>">
                                <button type="button" class="btn btn-outline-light border text-muted" title="Voice Search"><i class="bi bi-mic"></i></button>
                                <button type="button" class="btn btn-outline-light border text-muted" title="Barcode Search"><i class="bi bi-upc-scan"></i></button>
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase">Category</label>
                            <select name="category" class="form-select" onchange="this.form.submit()">
                                <option value="">All Categories</option>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat._id %>" <%= query.category == cat._id ? 'selected' : '' %>><%= cat.name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- Price Range -->
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase">Price Range</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" name="minPrice" class="form-control form-control-sm" placeholder="Min" value="<%= query.minPrice %>">
                                </div>
                                <div class="col-6">
                                    <input type="number" name="maxPrice" class="form-control form-control-sm" placeholder="Max" value="<%= query.maxPrice %>">
                                </div>
                            </div>
                        </div>

                        <!-- Stock Status -->
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase">Stock Status</label>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="stockStatus" id="stockAll" value="" <%= !query.stockStatus ? 'checked' : '' %> onchange="this.form.submit()">
                                    <label class="form-check-label" for="stockAll">All Items</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="stockStatus" id="stockIn" value="in" <%= query.stockStatus === 'in' ? 'checked' : '' %> onchange="this.form.submit()">
                                    <label class="form-check-label" for="stockIn">In Stock</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="stockStatus" id="stockLow" value="low" <%= query.stockStatus === 'low' ? 'checked' : '' %> onchange="this.form.submit()">
                                    <label class="form-check-label text-warning" for="stockLow">Low Stock</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="stockStatus" id="stockOut" value="out" <%= query.stockStatus === 'out' ? 'checked' : '' %> onchange="this.form.submit()">
                                    <label class="form-check-label text-danger" for="stockOut">Out of Stock</label>
                                </div>
                            </div>
                        </div>

                        <!-- Tag Cloud -->
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase">Tags</label>
                            <div class="d-flex flex-wrap gap-1">
                                <% allTags.forEach(tag => { %>
                                    <a href="/products?tag=<%= tag %>" class="badge <%= query.tag === tag ? 'bg-primary' : 'bg-body-tertiary text-muted' %> text-decoration-none">
                                        <%= tag %>
                                    </a>
                                <% }) %>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
                            <a href="/products" class="btn btn-light btn-sm">Reset All</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Main Product Display -->
        <div class="col-lg-9">
            <!-- Sort & Results Info -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small">Showing <strong><%= products.length %></strong> of <strong><%= total %></strong> products</span>
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted text-nowrap">Sort by:</label>
                    <select class="form-select form-select-sm w-auto" onchange="window.location.href='/products?' + new URLSearchParams({...<%= JSON.stringify(query) %>, sort: this.value}).toString()">
                        <option value="createdAt_desc" <%= query.sort === 'createdAt_desc' ? 'selected' : '' %>>Newest First</option>
                        <option value="price_asc" <%= query.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                        <option value="price_desc" <%= query.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                        <option value="name_asc" <%= query.sort === 'name_asc' ? 'selected' : '' %>>Name: A-Z</option>
                        <option value="stock_desc" <%= query.sort === 'stock_desc' ? 'selected' : '' %>>Stock: High to Low</option>
                    </select>
                </div>
            </div>

            <% if (products.length === 0) { %>
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-search fs-1 text-muted mb-3 d-block"></i>
                        <h5 class="fw-bold">No products found</h5>
                        <p class="text-muted">Try adjusting your filters or search terms.</p>
                        <a href="/products" class="btn btn-primary btn-sm">Clear All Filters</a>
                    </div>
                </div>
            <% } else if (view === 'grid') { %>
                <!-- Grid View -->
                <div class="row g-3">
                    <% products.forEach(product => { %>
                        <div class="col-xl-3 col-md-4 col-6">
                            <div class="card h-100 product-card animate-up">
                                <div class="position-relative">
                                    <% if (product.images && product.images.length > 0) { %>
                                        <img src="<%= product.images.find(i => i.isPrimary)?.url || product.images[0].url %>" class="card-img-top" alt="<%= product.name %>" style="height: 180px; object-fit: cover;">
                                    <% } else { %>
                                        <div class="bg-body-tertiary d-flex align-items-center justify-content-center" style="height: 180px;">
                                            <i class="bi bi-image text-muted fs-1"></i>
                                        </div>
                                    <% } %>
                                    <div class="position-absolute top-0 end-0 p-2">
                                        <span class="badge <%= product.quantity > product.reorderLevel ? 'bg-success' : product.quantity > 0 ? 'bg-warning text-dark' : 'bg-danger' %> shadow-sm">
                                            <%= product.quantity %> in stock
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <div>
                                        <small class="text-primary fw-bold text-uppercase d-block mb-1" style="font-size: 0.7rem;"><%= product.category?.name || 'Uncategorized' %></small>
                                        <h6 class="card-title fw-bold mb-2 text-truncate" title="<%= product.name %>"><%= product.name %></h6>
                                    </div>
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="fw-bold text-body fs-5">Rs.<%= product.price.toLocaleString() %></span>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a href="/products/<%= product._id %>" class="btn btn-sm btn-icon btn-icon-soft-primary flex-grow-1" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="/products/<%= product._id %>/edit" class="btn btn-sm btn-icon btn-icon-soft-warning flex-grow-1" title="Edit Product">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form action="/products/<%= product._id %>/delete" method="POST" class="d-inline flex-grow-1" onsubmit="return confirm('Archive this product?')">
                                                <button type="submit" class="btn btn-sm btn-icon btn-icon-soft-danger w-100" title="Delete Product">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <!-- List View -->
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Product Info</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th>Status</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% products.forEach(product => { %>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center gap-3">
                                                    <% if (product.images && product.images.length > 0) { %>
                                                        <img src="<%= product.images.find(i => i.isPrimary)?.url || product.images[0].url %>" class="rounded shadow-sm" width="40" height="40" style="object-fit: cover;">
                                                    <% } else { %>
                                                        <div class="bg-body-tertiary rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;">
                                                            <i class="bi bi-box text-muted"></i>
                                                        </div>
                                                    <% } %>
                                                    <div>
                                                        <div class="fw-bold"><%= product.name %></div>
                                                        <small class="text-muted">SKU: <%= product.sku %></small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= product.category?.name %></td>
                                            <td class="fw-bold">Rs.<%= product.price.toLocaleString() %></td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span><%= product.quantity %></span>
                                                    <div class="progress w-100" style="height: 4px; min-width: 60px;">
                                                        <div class="progress-bar <%= product.quantity > product.reorderLevel ? 'bg-success' : 'bg-warning' %>" style="width: <%= Math.min((product.quantity / 100) * 100, 100) %>%"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge <%= product.status === 'active' ? 'bg-success-soft text-success' : 'bg-secondary-soft text-secondary' %>">
                                                    <%= product.status %>
                                                </span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <div class="btn-group">
                                                    <a href="/products/<%= product._id %>" class="btn btn-sm btn-icon btn-light" title="View"><i class="bi bi-eye"></i></a>
                                                    <a href="/products/<%= product._id %>/edit" class="btn btn-sm btn-icon btn-light" title="Edit"><i class="bi bi-pencil"></i></a>
                                                    <form action="/products/<%= product._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Archive this product?')">
                                                        <button type="submit" class="btn btn-sm btn-icon btn-light text-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item <%= currentPage == 1 ? 'disabled' : '' %>">
                            <a class="page-link shadow-sm" href="/products?<%= new URLSearchParams({...query, page: currentPage - 1}).toString() %>">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        <% for(let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                <a class="page-link shadow-sm" href="/products?<%= new URLSearchParams({...query, page: i}).toString() %>"><%= i %></a>
                            </li>
                        <% } %>
                        <li class="page-item <%= currentPage == totalPages ? 'disabled' : '' %>">
                            <a class="page-link shadow-sm" href="/products?<%= new URLSearchParams({...query, page: currentPage + 1}).toString() %>">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            <% } %>
        </div>
    </div>
</div>

<style>
    .product-card {
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: var(--bs-card-bg, #fff);
    }
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
        border-color: rgba(13, 110, 253, 0.2);
    }
    .btn-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 1px solid transparent;
    }
    .btn-icon-soft-primary {
        background: rgba(13, 110, 253, 0.06);
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.12);
        transition: all 0.2s ease;
    }
    .btn-icon-soft-primary:hover {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }
    .btn-icon-soft-warning {
        background: rgba(255, 193, 7, 0.06);
        color: #ffc107;
        border-color: rgba(255, 193, 7, 0.12);
        transition: all 0.2s ease;
    }
    .btn-icon-soft-warning:hover {
        background: #ffc107;
        color: #212529;
        border-color: #ffc107;
    }
    .btn-icon-soft-danger {
        background: rgba(220, 53, 69, 0.06);
        color: #dc3545;
        border-color: rgba(220, 53, 69, 0.12);
        transition: all 0.2s ease;
    }
    .btn-icon-soft-danger:hover {
        background: #dc3545;
        color: #fff;
        border-color: #dc3545;
    }
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
    .bg-secondary-soft { background: rgba(100, 116, 139, 0.1); }
    .pagination .page-link {
        border: none;
        margin: 0 3px;
        border-radius: 8px;
        color: var(--secondary);
    }
    .pagination .page-item.active .page-link {
        background-color: var(--primary);
        color: white;
    }
</style>
