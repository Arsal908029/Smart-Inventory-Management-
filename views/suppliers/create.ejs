<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-plus-circle"></i> Add Supplier</h2>
    <a href="/suppliers" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Suppliers
    </a>
</div>

<% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>

<div class="card shadow-sm max-w-800 mx-auto">
    <div class="card-body p-4">
        <form action="/suppliers" method="POST">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="name" class="form-label">Company Name *</label>
                    <input type="text" class="form-control" id="name" name="name" value="<%= supplier ? supplier.name : '' %>" required>
                </div>
                
                <div class="col-md-6">
                    <label for="contact" class="form-label">Contact Person *</label>
                    <input type="text" class="form-control" id="contact" name="contact" value="<%= supplier ? supplier.contact : '' %>" required>
                </div>

                <div class="col-md-6">
                    <label for="email" class="form-label">Email Address *</label>
                    <input type="email" class="form-control" id="email" name="email" value="<%= supplier ? supplier.email : '' %>" required>
                </div>

                <div class="col-md-6">
                    <label for="phone" class="form-label">Phone Number *</label>
                    <input type="text" class="form-control" id="phone" name="phone" value="<%= supplier ? supplier.phone : '' %>" required>
                </div>

                <div class="col-md-6">
                    <label for="leadTimeDays" class="form-label">Lead Time (Days)</label>
                    <input type="number" class="form-control" id="leadTimeDays" name="leadTimeDays" value="<%= supplier ? supplier.leadTimeDays : 7 %>" min="0">
                </div>

                <div class="col-md-6">
                    <label for="rating" class="form-label">Supplier Rating (1-5)</label>
                    <input type="number" class="form-control" id="rating" name="rating" value="<%= supplier ? supplier.rating : 3 %>" min="1" max="5">
                </div>

                <div class="col-12">
                    <label for="address" class="form-label">Physical Address</label>
                    <textarea class="form-control" id="address" name="address" rows="3"><%= supplier ? supplier.address : '' %></textarea>
                </div>

                <div class="col-12 mt-4">
                    <hr class="mt-0">
                    <div class="d-flex justify-content-end gap-2">
                        <a href="/suppliers" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Save Supplier
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
